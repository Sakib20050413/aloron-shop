datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKAGING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
}

model Product {
  id              String      @id @default(cuid())
  code            String      @unique // e.g. "GAD-WATCH-01"
  slug            String      @unique // e.g. "qcy-gt2-amoled-smart-watch"
  name            String      // Bengali title
  nameEn          String?     // English title
  category        String      // "SMART GADGET", "CHARGER", "AUDIO", "CABLE"
  price           Float
  originalPrice   Float?
  wholesaleCost   Float?
  stock           Int         @default(15)
  images          String[]    // Array of image URLs
  videoUrl        String?     // Optional product video URL
  description     String
  specs           Json?       // e.g. {"Display": "1.43\" AMOLED", "Waterproof": "5ATM"}
  whatsInTheBox   String[]    // Dynamic unboxing list
  isTrending      Boolean     @default(false)
  isFeatured      Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
}

model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  subtitle    String
  badgeText   String
  discountTag String
  priceText   String
  ctaText     String   @default("কালেকশন দেখুন")
  ctaLink     String   @default("/products")
  imageUrl    String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique // Format: ALR-YYMM-XXXX
  customerName      String
  customerPhone     String
  deliveryAddress   String
  deliveryZone      String      // "inside_dhaka" | "outside_dhaka"
  deliveryFee       Float
  totalAmount       Float
  advancePaid       Float       @default(200)
  dueAmount         Float
  bkashSenderNumber String
  bkashTrxId        String
  status            OrderStatus @default(PENDING)
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Float
  quantity  Int
  image     String?
}

model StoreSetting {
  id                   String   @id @default("global")
  announcementText     String   @default("ঢাকা থেকে সারাদেশে দ্রুততম হোম ডেলিভারি | হটলাইন: ০১৬১৫৮৬৯৭২৪")
  supportPhone         String   @default("01615869724")
  supportWhatsApp      String   @default("8801615869724")
  deliveryInsideDhaka  Float    @default(70)
  deliveryOutsideDhaka Float    @default(150)
  advanceBkashAmount   Float    @default(200)
  bkashNumber          String   @default("01615869724")
  bkashAccountType     String   @default("Personal")
  updatedAt            DateTime @updatedAt
}
